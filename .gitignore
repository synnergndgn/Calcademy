# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local runtime and Supabase CLI state. Examples may be committed with an
# `.example` suffix, but real project credentials never belong in Git.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
/supabase/.temp/
/.claude/settings.local.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Device logcat captures. A full capture lists every installed package on the
# device it was taken from, so it is personal data about the developer and
# stays local — no exceptions. `crash_log.txt` was tracked until 1.9.4+28; the
# Calcademy fault it held is preserved as
# docs/startup_crash_evidence_1_0_0_6.md.
crash_log.txt
*_crash_log.txt
admob_retry_*.txt
admob_internal_*.txt
logcat_*.txt
